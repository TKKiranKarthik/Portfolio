<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kiran Karthik — Mechanical Designer, Additive Manufacturing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1B2229;
    --paper:#E9E6DD;
    --paper-2:#DEDACC;
    --navy:#1E2A38;
    --navy-2:#263850;
    --steel:#7C8792;
    --steel-line:#B9BCB4;
    --signal:#FF5A1F;
    --blueprint:#7FAFB8;
    --display: 'Space Grotesk', sans-serif;
    --body: 'IBM Plex Sans', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:var(--body);
    line-height:1.6;
  }
  a{color:inherit;}

  /* ---------- layout shell ---------- */
  .shell{
    display:grid;
    grid-template-columns: 280px 1fr;
    min-height:100vh;
  }
  @media (max-width:860px){
    .shell{grid-template-columns:1fr;}
  }

  /* ---------- sidebar ---------- */
  .sidebar{
    background:var(--navy);
    color:var(--paper);
    position:sticky;
    top:0;
    height:100vh;
    padding:44px 32px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
  }
  @media (max-width:860px){
    .sidebar{
      position:relative;
      height:auto;
      padding:28px 24px;
    }
  }
  .brand h1{
    font-family:var(--display);
    font-size:1.55rem;
    line-height:1.15;
    margin:0 0 6px;
    font-weight:700;
    letter-spacing:0.01em;
  }
  .brand .role{
    font-size:0.86rem;
    color:var(--blueprint);
    font-family:var(--mono);
    margin:0 0 28px;
  }
  .ruler-nav{
    list-style:none;
    margin:0;
    padding:0;
    border-left:1px solid rgba(233,230,221,0.25);
  }
  .ruler-nav li{position:relative;}
  .ruler-nav a{
    display:block;
    padding:10px 0 10px 22px;
    text-decoration:none;
    font-size:0.92rem;
    color:rgba(233,230,221,0.7);
    transition:color .2s;
  }
  .ruler-nav a:hover{color:var(--paper);}
  .ruler-nav li::before{
    content:"";
    position:absolute;
    left:-1px;
    top:18px;
    width:12px;
    height:1px;
    background:rgba(233,230,221,0.35);
  }
  .ruler-nav a.active{color:var(--signal);}
  .ruler-nav li.active::before{background:var(--signal); width:16px; height:2px;}

  .sidebar-foot{
    font-family:var(--mono);
    font-size:0.72rem;
    color:var(--steel);
    letter-spacing:0.02em;
  }
  @media (max-width:860px){ .sidebar-foot{display:none;} }

  /* ---------- main ---------- */
  main{padding:0;}
  .hero{
    padding:76px 56px 56px;
    border-bottom:1px solid var(--steel-line);
  }
  @media (max-width:860px){ .hero{padding:48px 24px 36px;} }
  .stamp{
    width:64px;height:64px;border-radius:50%;
    border:2px solid var(--signal);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--display);
    font-weight:700;
    font-size:1.1rem;
    color:var(--signal);
    transform:rotate(-8deg);
    margin-bottom:24px;
  }
  .hero h2{
    font-family:var(--display);
    font-size:clamp(1.9rem, 4vw, 2.9rem);
    line-height:1.15;
    max-width:15ch;
    margin:0 0 18px;
    font-weight:600;
  }
  .hero p.lede{
    max-width:56ch;
    font-size:1.05rem;
    color:#3A4148;
    margin:0 0 26px;
  }
  .hero .quickfacts{
    display:flex;
    gap:28px;
    flex-wrap:wrap;
    font-family:var(--mono);
    font-size:0.82rem;
    color:var(--steel);
  }
  .hero .quickfacts b{color:var(--ink); font-weight:600;}

  section{
    padding:52px 56px;
    border-bottom:1px solid var(--steel-line);
  }
  @media (max-width:860px){ section{padding:36px 24px;} }

  .dim-label{
    display:flex;
    align-items:center;
    gap:14px;
    margin:0 0 30px;
  }
  .dim-label .tick{
    width:22px;height:1px;background:var(--steel);
    position:relative;
  }
  .dim-label .tick::before,.dim-label .tick::after{
    content:"";position:absolute;top:-4px;width:1px;height:9px;background:var(--steel);
  }
  .dim-label .tick::before{left:0;}
  .dim-label .tick::after{right:0;}
  .dim-label h3{
    font-family:var(--display);
    font-size:1.25rem;
    margin:0;
    font-weight:600;
  }

  /* ---------- timeline (experience + education merged, real chronology) ---------- */
  .timeline{
    position:relative;
    padding-left:26px;
    border-left:2px solid var(--paper-2);
  }
  .t-item{
    position:relative;
    padding-bottom:34px;
  }
  .t-item:last-child{padding-bottom:0;}
  .t-item::before{
    content:"";
    position:absolute;
    left:-32px;
    top:4px;
    width:9px;height:9px;
    border-radius:50%;
    background:var(--navy);
    border:2px solid var(--signal);
  }
  .t-item .when{
    font-family:var(--mono);
    font-size:0.78rem;
    color:var(--steel);
    display:block;
    margin-bottom:4px;
  }
  .t-item h4{
    font-family:var(--display);
    font-size:1.05rem;
    margin:0 0 4px;
    font-weight:600;
  }
  .t-item .org{
    font-size:0.88rem;
    color:var(--steel);
    margin:0 0 10px;
  }
  .t-item ul{
    margin:0;
    padding-left:18px;
  }
  .t-item li{margin-bottom:6px; font-size:0.95rem;}

  /* ---------- skills, grouped not soup ---------- */
  .skill-row{
    display:grid;
    grid-template-columns:170px 1fr;
    gap:18px;
    padding:14px 0;
    border-top:1px solid var(--paper-2);
    align-items:baseline;
  }
  .skill-row:first-of-type{border-top:none;}
  .skill-row .cat{
    font-family:var(--mono);
    font-size:0.78rem;
    color:var(--steel);
  }
  .chips{display:flex; flex-wrap:wrap; gap:8px;}
  .chip{
    border:1px solid var(--steel-line);
    padding:6px 12px;
    font-size:0.86rem;
    background:transparent;
    transition:background .2s, color .2s, border-color .2s;
  }
  .chip:hover{background:var(--signal); border-color:var(--signal); color:var(--paper);}

  /* ---------- academic projects ---------- */
  .proj-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:20px;
  }
  .proj{
    border-left:3px solid var(--blueprint);
    padding:4px 0 4px 18px;
  }
  .proj h4{
    font-family:var(--display);
    font-size:1rem;
    margin:0 0 8px;
    font-weight:600;
    text-transform:none;
  }
  .proj p{margin:0; font-size:0.92rem; color:#3A4148;}

  /* ---------- contact / spec sheet ---------- */
  .spec{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:1px;
    background:var(--paper-2);
    border:1px solid var(--paper-2);
  }
  .spec div{
    background:var(--paper);
    padding:18px 20px;
  }
  .spec .k{
    display:block;
    font-family:var(--mono);
    font-size:0.72rem;
    color:var(--steel);
    margin-bottom:6px;
  }
  .spec .v{font-size:0.98rem;}
  .spec .v a{text-decoration:none; border-bottom:1px solid var(--signal);}

  footer{
    padding:26px 56px;
    font-family:var(--mono);
    font-size:0.72rem;
    color:var(--steel);
  }
  @media (max-width:860px){ footer{padding:20px 24px;} }
</style>
</head>
